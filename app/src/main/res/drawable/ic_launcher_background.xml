<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the backdrop gradient of media/app_icon.png so the inset artwork
     blends into the adaptive icon mask. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#BBE2F1"
        android:startColor="#D7F3FE"
        android:type="linear" />
</shape>
